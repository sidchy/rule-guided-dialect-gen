# ============================================================
# .env.example -- LLM API 配置模板
# ============================================================
# 复制此文件为 .env 并填入你的 API 密钥：
#   cp .env.example .env
#
# .env 文件已在 .gitignore 中，不会被提交到 git。
# ============================================================

# ------ Qwen / 通义千问 (通过 DashScope 兼容 OpenAI 格式) ------
OPENAI_API_KEY=sk-your-qwen-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# ------ DeepSeek ------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------ Provider 路由 ------
# dialect.yaml 中的 llm.primary_provider / llm.secondary_provider
# 会映射到这里对应的 KEY/BASE_URL/MODEL
PRIMARY_PROVIDER=qwen
PRIMARY_MODEL=qwen-plus
SECONDARY_PROVIDER=deepseek
SECONDARY_MODEL=deepseek-chat

# ------ 其他 OpenAI 兼容 API（可选）------
# 如果你用的是其他兼容 OpenAI 格式的 API，按上面的格式配置即可。
# 例如 Moonshot、智谱、百川等。
